{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "ignoreCommand": "exit 1",
  "installCommand": "npm install --global npm@11.12.1 && npm ci",
  "buildCommand": "npm run format:check -- '!vercel.json' && npm run verify",
  "outputDirectory": "dist/market-stream-dashboard/browser",
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/(?:market|setup)?/?$", "dest": "/index.html" },
    { "src": "/.*", "status": 404 }
  ]
}
